# Server Configuration
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="Campus Laundry Booking & Billing System"

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campus_laundry_db

# Fallback Settings
# Set to 'true' to allow automatic SQLite fallback if MySQL is offline or credentials are not yet set
USE_SQLITE_FALLBACK=true
